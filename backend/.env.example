# Mode Configuration
# Set MODE to "local" for local filesystem or "dropbox" for Dropbox API
MODE=local

# Local Filesystem Configuration (only used when MODE=local)
# Set the root directory to scan. Leave empty to use your home directory
LOCAL_ROOT_PATH=/path/to/your/files

# Dropbox API Configuration (only used when MODE=dropbox)
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token_here
DROPBOX_APP_KEY=your_app_key_here
DROPBOX_APP_SECRET=your_app_secret_here

# Database
DATABASE_URL=sqlite:///./dropbox_sorter.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Analysis Configuration
PERCEPTUAL_HASH_SIZE=8
SIMILARITY_THRESHOLD=5
MAX_FILE_SIZE_MB=100
CACHE_EXPIRY_HOURS=24
